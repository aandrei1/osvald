# ---------------------------------------------------------------------------
# Root environment for Docker Compose (copy to `.env` to override defaults).
# Compose already ships working defaults for every value below, so `.env` is
# optional for `pnpm docker:up`.
#
# For running the backend on the host (`pnpm dev`), copy this file to
# packages/backend/.env instead — the host must use `localhost` plus the
# published host ports (5433 / 6379 / 8001), not the in-network service names.
# ---------------------------------------------------------------------------

# Host port 5433: 5432 is already taken by another local stack on this machine.
POSTGRES_USER=osvald
POSTGRES_PASSWORD=osvald
POSTGRES_DB=osvald
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=3000
LOG_LEVEL=info
JWT_SECRET=dev-only-secret-change-me-min-32-characters-long
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://localhost,capacitor://localhost

# OCR service (host port 8001: 8000 is already taken by another local stack)
OCR_SERVICE_PORT=8001
# Language pack. Also baked into the image when WITH_PADDLE=true.
OCR_LANGUAGE=ro
# Install PaddleOCR in the image (adds >1 GB) so scanned PDFs can be read.
# PDFs that already carry a text layer need nothing extra.
#   docker compose build ocr-service      # after setting this to true
WITH_PADDLE=false
# Most pages a single request may OCR; 0 lifts the cap.
OCR_MAX_OCR_PAGES=80
OCR_MAX_UPLOAD_BYTES=67108864

# Frontend dev server (Vite)
VITE_PORT=5173
