# Frontend environment — copy to `packages/frontend/.env`.
# Only VITE_-prefixed variables are exposed to client code.

# Base URL of the backend API (no trailing slash).
# Must match the backend's PORT. Change both if 3000 is taken on your machine.
VITE_API_BASE_URL=http://localhost:3000

# Dev server port (also used by `vite.config.ts`).
VITE_PORT=5173
