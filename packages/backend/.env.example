# Backend environment — copy to `packages/backend/.env` and adjust.
#
# These defaults target a backend running ON THE HOST against the Compose
# services (note the published host ports: Postgres 5433, OCR 8001).

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# Postgres (host port 5433 to avoid clashing with another local Postgres)
DATABASE_URL=postgres://osvald:osvald@localhost:5433/osvald
DATABASE_POOL_MAX=10

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Auth (@fastify/jwt) — must be at least 32 characters
JWT_SECRET=dev-only-secret-change-me-min-32-characters-long
JWT_EXPIRES_IN=1h

# Comma-separated list of allowed browser origins.
# 5173 = Vite dev server, 4173 = `vite preview`,
# `capacitor://localhost` = iOS shell, `http://localhost` = Android shell.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://localhost,capacitor://localhost

# PDF uploads (@fastify/multipart)
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=26214400

# Python OCR service
OCR_SERVICE_URL=http://localhost:8001
OCR_REQUEST_TIMEOUT_MS=30000
# Whole-document extraction can take minutes when pages need OCR.
OCR_PDF_TIMEOUT_MS=900000
# Language pack the OCR service runs with (must match OCR_LANGUAGE there).
OCR_LANGUAGE=ro

# Python TTS service (server-side speech, so voices do not depend on the OS)
TTS_SERVICE_URL=http://localhost:8002
TTS_REQUEST_TIMEOUT_MS=5000
# The first call to a voice also loads its model.
TTS_SYNTHESIS_TIMEOUT_MS=60000

# BullMQ script-parsing worker
SCRIPT_PARSING_WORKER_ENABLED=true
SCRIPT_PARSING_CONCURRENCY=2
