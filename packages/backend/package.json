{
  "name": "@osvald/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify + Drizzle + BullMQ API for the Osvald rehearsal app",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/queue/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/queue/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "db:seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/jwt": "10.2.2",
    "@fastify/multipart": "10.1.1",
    "@fastify/swagger": "9.8.2",
    "@node-rs/argon2": "^2.2.1",
    "@osvald/shared": "workspace:*",
    "bullmq": "6.3.8",
    "dotenv": "18.0.2",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "openapi-types": "12.1.3",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
